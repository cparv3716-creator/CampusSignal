# Copy this file to .env for local development.
CAMPUS_SIGNAL_APP_NAME="CampusSignal API"
CAMPUS_SIGNAL_DATABASE_URL="sqlite:///./campus_signal.db"

# Local Gmail Desktop OAuth files. Never commit either JSON file.
GMAIL_CREDENTIALS_FILE="./credentials.json"
GMAIL_TOKEN_FILE="./token.json"
GMAIL_USER_ID="me"

# Pub/Sub resource names may be short names or fully qualified paths.
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"
GMAIL_PUBSUB_TOPIC="gmail-notifications"
GMAIL_PUBSUB_SUBSCRIPTION="gmail-notifications-local"
