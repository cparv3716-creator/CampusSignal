# Copy the required values into your local environment. Never commit secrets.
SERVER_ADDRESS=127.0.0.1
PORT=8080

DATABASE_URL=jdbc:h2:file:./data/campussignal
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Production PostgreSQL profile (use a JDBC URL; keep credentials out of source control).
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/campussignal
DB_USERNAME=
DB_PASSWORD=
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
JPA_DDL_AUTO=update

# Optional fictional demo fixtures. Gmail is never accessed by this initializer.
DEMO_DATA_ENABLED=false

# Experimental local-only HTTP sync; leave disabled for shared/production deployments.
GMAIL_SYNC_ENABLED=false
GMAIL_SYNC_TOKEN=

GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_DIRECTORY=.gmail-tokens
GMAIL_CALLBACK_PORT=8888
GMAIL_MAX_RESULTS=10
GMAIL_USER_ID=me

# Web Google OAuth. Create a Web application OAuth client; do not use the desktop client here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the actual backend port. The currently documented local browser stack uses 8092.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8092/api/v1/auth/google/callback
# A base64-encoded, random 32-byte AES key. Generate and keep this only in the deployment secret store.
CAMPUSSIGNAL_TOKEN_ENCRYPTION_KEY=
CAMPUSSIGNAL_AUTH_REQUIRED=true
CAMPUSSIGNAL_AUTH_SESSION_HOURS=8
CAMPUSSIGNAL_FRONTEND_URI=http://127.0.0.1:5174
# Set true behind HTTPS. Local HTTP development requires false.
CAMPUSSIGNAL_COOKIE_SECURE=false

# Vite-only variable. Keep it in frontend/.env.local for local use, never commit a real deployment config.
CAMPUSSIGNAL_API_TARGET=http://127.0.0.1:8092

GOOGLE_CLOUD_PROJECT=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_RECOVERY_MAX_RESULTS=10

CATEGORY_SCORE_EXPLICIT_WEIGHT=0.40
CATEGORY_SCORE_PROFILE_WEIGHT=0.15
CATEGORY_SCORE_BEHAVIORAL_WEIGHT=0.35
CATEGORY_SCORE_RELATED_WEIGHT=0.10
CATEGORY_SCORE_INITIAL_BEHAVIORAL=0.5
CATEGORY_SCORE_INITIAL_RELATED=0.0
