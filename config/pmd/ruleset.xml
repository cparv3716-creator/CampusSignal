<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="CampusSignal maintainability"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
    <description>
        PMD's standard Java quickstart rules plus focused design metrics for CampusSignal's
        initial maintainability and control-flow complexity analysis.
    </description>

    <rule ref="rulesets/java/quickstart.xml"/>

    <!-- PMD 7 replaced the old excessive-length rules with NCSS-based size analysis. -->
    <rule ref="category/java/design.xml/AvoidDeeplyNestedIfStmts"/>
    <rule ref="category/java/design.xml/CognitiveComplexity"/>
    <rule ref="category/java/design.xml/CollapsibleIfStatements"/>
    <rule ref="category/java/design.xml/CyclomaticComplexity"/>
    <rule ref="category/java/design.xml/ExcessiveParameterList"/>
    <rule ref="category/java/design.xml/GodClass"/>
    <rule ref="category/java/design.xml/NcssCount"/>
    <rule ref="category/java/design.xml/NPathComplexity"/>
    <rule ref="category/java/design.xml/SimplifyBooleanExpressions"/>
    <rule ref="category/java/design.xml/TooManyMethods"/>
</ruleset>
